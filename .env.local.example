# https://replicate.com/account/api-tokens
# Not: BYOK modelinde bu, uygulamanın kendi fallback/demo anahtarıdır — gerçek kullanıcılar
# panelden kendi anahtarlarını ekler ve üretimde o kullanılır.
REPLICATE_API_TOKEN=

# Full "owner/name:version" string from the model's API tab, e.g.
# https://replicate.com/adirik/interior-design/api
REPLICATE_MODEL=

# --- Veritabanı ---
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth v5) ---
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3020

# --- Kullanıcı API anahtarları şifreleme ---
# 32 byte (base64). Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=

# --- Stripe ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
# https://dashboard.stripe.com/test/products — $10/ay tekrarlayan Price ID
STRIPE_PRICE_SUBSCRIPTION=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3020
